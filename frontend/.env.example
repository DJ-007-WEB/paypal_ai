# Optional. The SPA defaults to the same-origin `/api` base.
# Keep this relative (or unset) in deployed builds so Vercel can proxy to the
# backend and the host-only OAuth/session cookies round-trip correctly.
VITE_API_BASE_URL=/api

# Local Vite dev-server proxy target only. Never put server secrets here.
VITE_DEV_API_PROXY=http://localhost:3000
